# ==============================================================================
# BERNING ESSENTIALS — ENVIRONMENT VARIABLES TEMPLATE
# Copy to .env for local testing or configure in the Render Web Service Dashboard
# ==============================================================================

# Application Environment Mode (development | production)
APP_ENV=production

# TiDB Cloud Database Connection
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_NAME=berning_essentials

# TiDB Cloud Authentication Credentials (Set in Render Dashboard -> Environment)
DB_USER=your_tidb_username_here
DB_PASS=your_tidb_password_here

# TiDB Cloud SSL CA Certificate Path
# (Set via Render Dashboard -> Secret Files: Mount path /etc/secrets/isrgrootx1.pem)
DB_SSL_CA_PATH=/etc/secrets/isrgrootx1.pem
